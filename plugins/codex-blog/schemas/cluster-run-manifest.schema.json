{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BruceL017/codex-blog/schemas/cluster-run-manifest.schema.json",
  "title": "Codex Blog Cluster Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "seed_keyword",
    "status",
    "output_dir",
    "plan",
    "plan_digest",
    "image_mode",
    "image_decision",
    "articles",
    "warnings",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "seed_keyword": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "awaiting_articles",
        "non_image_complete",
        "images_planned",
        "complete",
        "complete_with_warnings"
      ]
    },
    "output_dir": {"type": "string", "minLength": 1},
    "plan": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_mode": {"enum": ["deferred", "hero", "full"]},
    "image_decision": {
      "enum": ["not_asked", "asked", "declined", "hero", "full"]
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/article"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "article": {
      "type": "object",
      "required": [
        "id",
        "role",
        "cluster",
        "position",
        "title",
        "primary_keyword",
        "slug",
        "run_dir",
        "article",
        "request",
        "status",
        "finalize_attempts",
        "image_status",
        "image_attempts",
        "error"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["pillar", "spoke"]},
        "cluster": {"type": "string"},
        "position": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "primary_keyword": {"type": "string", "minLength": 1},
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "run_dir": {"type": "string", "minLength": 1},
        "article": {"type": "string", "minLength": 1},
        "request": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "awaiting_article",
            "ready_to_finalize",
            "non_image_complete",
            "blocked",
            "failed"
          ]
        },
        "finalize_attempts": {"type": "integer", "minimum": 0, "maximum": 3},
        "image_status": {
          "enum": ["not_requested", "pending", "planned", "complete", "degraded"]
        },
        "image_attempts": {"type": "integer", "minimum": 0, "maximum": 2},
        "error": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
